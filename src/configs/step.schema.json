    "Check": {
      "additionalProperties": false,
      "description": "One validation check (a \"tab\" in the UI).\n\nEach check independently obtains an output \u2014 either by running its own action\n(action_type/object_name/params, e.g. a table read) or, when it declares no\naction, by inspecting the executed step's own spool/rows \u2014 and judges it against\nits own condition (`mode`). A check emits a pass/fail; the step's final verdict\ncombines the *required* checks per `Validate.combine`. `required: false` makes a\ncheck evidence-only (its output is gathered for analysis but does not gate).\nLater checks may reference an earlier check's output via `{{<name>.rows_text}}` /\n`{{<name>.spool_text}}` placeholders in their params.",
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "action_type": {
          "anyOf": [
            {
              "enum": [
                "SUBMIT",
                "FM",
                "BAPI",
                "BDC",
                "TOOLS"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Action Type"
        },
        "object_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Object Name"
        },
        "connector": {
          "default": "sap_rfc",
          "label": "Connector",
          "title": "Connector",
          "type": "string",
          "widget": "text"
        },
        "async": {
          "default": false,
          "title": "Async",
          "type": "boolean"
        },
        "test_run": {
