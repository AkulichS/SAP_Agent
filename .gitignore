# Python bytecode
__pycache__/
*.pyc
*.pyo

# Environment / secrets
.env

# Runtime logs
*.log

# SQLite checkpoint database (runtime state, not source)
*.db
*.db-shm
*.db-wal

# Images / screenshots
*.jpg
*.png

# Claude Code local settings
.claude/

# Test / coverage artifacts
.coverage
.coverage.*
htmlcov/
.pytest_cache/

# Config delta store (per-deployment tenant data)
config_store.db
config_store.db-*

# Licensing — the private signing key MUST NEVER be committed; issued licenses are
# per-customer artifacts. The public key (configs/license_pubkey.pem) may be committed.
license_signing_key.pem
*.lic
